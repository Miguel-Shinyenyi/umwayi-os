__pycache__/
*.pyc
*.egg-info/
build/
dist/
# the built page of layer 12 is committed (ui/dist/index.html and build.json)
!ui/dist/
.pytest_cache/
.venv/

# private memory stays out of git
memory/private/
memory/journal/*-private.md

# secrets
.env
.env.*
*.pem
*.key

# logbook lock (exists only while an umwayi command writes)
.umwayi/logbook.lock
.umwayi/run.lock

# drafts and the outbox are the owner's material, not code
drafts/
outbox/

# the web interface snapshot (layer 12): the owner's counts, not code
.umwayi/snapshot.json

# the local backend (W6): the SHA-256 record of its token, and its one-server-per-root lock
.umwayi/serve.token
.umwayi/serve.lock
